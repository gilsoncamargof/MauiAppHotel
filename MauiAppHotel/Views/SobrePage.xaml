<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.SobrePage"
             Title="Sobre"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         HorizontalOptions="Center"
                         Padding="20"
                         Spacing="20">

        <Label Text="Sobre o Aplicativo"
               FontFamily="ShantellSans-ExtraBold"
               FontSize="35"
               TextColor="{StaticResource Primary}"
               HorizontalOptions="Center" />

       
        <Frame Padding="20"
               CornerRadius="15"
               HasShadow="True"
               BackgroundColor="White"
               WidthRequest="320">

            <VerticalStackLayout Spacing="10">

                <Label Text="Desenvolvedor:"
                       FontAttributes="Bold"
                       FontSize="18"
                       TextColor="Black"/>
                
                <Label Text="Gilson Antonio de Camargo Filho"
                       FontSize="16"
                       TextColor="DimGray"/>

                <Label Text="Ano de Desenvolvimento:"
                       FontAttributes="Bold"
                       FontSize="18"
                       Margin="0, 10, 0, 0"
                       TextColor="Black"/>
                <Label Text="2026"
                       FontSize="16"
                       TextColor="DimGray"/>

                <Label Text="Disciplina:"
                       FontAttributes="Bold"
                       FontSize="18"
                       Margin="0, 10, 0, 0"
                       TextColor="Black"/>
                
                <Label Text="Desenvolvimento de Sistemas II"
                       FontSize="16"
                       TextColor="DimGray"/>

            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>
</ContentPage>